# Optional overrides for Docker Compose. Defaults work without creating .env.
ADLIENS_PORT=8080
VITE_USE_MOCK_DATA=true
# This address is used by your browser, not by the container.
# A backend is not included; contact submission requires POST /leads here.
VITE_API_BASE_URL=http://localhost:3000/api
# Optional HTTPS agency introduction video (MP4). Leave empty for coming-soon artwork.
VITE_AGENCY_FILM_URL=

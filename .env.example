# Docker remains a local visual demo. No secrets are needed in this mode.
ADLIENS_PORT=8080
VITE_USE_MOCK_DATA=true
VITE_API_BASE_URL=/api
VITE_AGENCY_FILM_URL=

# Server-only values for a separate local/development database (never VITE_).
# Vercel production values are configured securely in the project dashboard.
DATABASE_URL=
BETTER_AUTH_SECRET=
APP_ORIGIN=http://localhost:3000
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Only needed for an initial `npm run db:setup` against your own database.
ADLIENS_ADMIN_EMAIL=
ADLIENS_ADMIN_PASSWORD=
SEED_DEMO=false
